# =============================================================================
# PRISM Phase-1 配置模板（复制为 default.yaml 后填写路径）
# =============================================================================

model: llava_onevision
model_args: "pretrained=your/model-name"
batch_size: "1"
device: null

calib_data: coco
n_samples: 128
data_path: ""
image_folder: ""
interleave_format: false
few_shot_format: false
text_data_path: ""

asd_theta1: 0.8
asd_theta2: 0.2
asd_normalize: true
asd_mixed_precision: true
asd_high_precision_ratio: 0.1
asd_low_w_bit: 4

run_process: true
scale_path: "scale_cache/prism_llava_7b_w4.pt"
w_bit: 4
w_group: 128
pseudo_quant: true

tasks: "mmmu_val"
limit: null
output_path: "eval_results"
seed: "0,1234,1234,1234"
gen_kwargs: ""
log_samples: false
verbosity: "INFO"
